#include<stdio.h>
 
int main()
{
int age,income,score;
printf("\n enter age,income and score:");
scanf("%d %d %d",&age,&income,&score);
if(age<21||age>60)
  printf("loan rejected:age is not in 21 to 60");
else if(income<25000)
  printf("loan rejected:income below 25000");
else if(score<700)
   printf("loan rejected:score below 700");
else 
    printf("loan approved");
}       
  
 