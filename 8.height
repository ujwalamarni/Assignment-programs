#include<stdio.h>
 
int main()
{
float weight,height,bmi;
printf("\n enter weight in kg eng height in meters:");
scanf("%f %f",&weight,&height);
bmi=weight/height*height;
printf("bmi=%.2f",bmi);
if (bmi<18.5)
   printf("under weight");
else if (bmi < 25)
        printf("Normal");
else if (bmi < 30)
        printf("Overweight");
else
     printf("Obese");
}  